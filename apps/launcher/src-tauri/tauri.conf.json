{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Neura-Core Launcher",
  "version": "0.1.0",
  "identifier": "com.neuracore.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Neura-Core Launcher",
        "width": 900,
        "height": 700,
        "minWidth": 420,
        "minHeight": 520,
        "resizable": true,
        "center": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQxODc4NjlFOUZDM0JCNjUKUldSbHU4T2Zub2FIMGZnVVlIaVE0ZlVsbVNuVFRqNTU1cEpQVTR5WkxxV21hY3hocUdKNFZaYUkK",
      "endpoints": [
        "https://github.com/AlexandreInking/NeuraCoreEngine/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
